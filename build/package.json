{
  "name": "md-view-build",
  "private": true,
  "type": "module",
  "description": "Bundles markdown-it and its plugins into mods/md-view/vendor/markdown.js.",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --platform=neutral --main-fields=module,main --minify --legal-comments=inline --outfile=../mods/md-view/vendor/markdown.js"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "markdown-it-github-alerts": "1.0.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
